# Brewfather Custom Stream logging ID (from Settings > Power-ups > Custom Stream)
BREWFATHER_LOGGING_ID=your_logging_id_here

# Brewfather post interval in minutes (minimum 15)
BREWFATHER_INTERVAL=15

# Web server port
PORT=3000

# --- Pill Configuration ---
# Configure each RAPT Pill with PILL_<n>_MAC and PILL_<n>_NAME (n = 1..10)
# BLE MAC is the registration MAC + 2 on the last octet

# Pill 1: Pastilla
PILL_1_MAC=90:38:0c:12:64:4a
PILL_1_NAME=Pastilla
# PILL_1_BREWFATHER_NAME=Pastilla
# PILL_1_GRAVITY_OFFSET=0
# PILL_1_TEMP_OFFSET=0

# Pill 2: Nuevo
PILL_2_MAC=ec:62:60:28:3e:4a
PILL_2_NAME=Nuevo
# PILL_2_BREWFATHER_NAME=Nuevo
# PILL_2_GRAVITY_OFFSET=0
# PILL_2_TEMP_OFFSET=0

# --- Legacy single-pill config (used if no PILL_<n> vars are set) ---
# PILL_MAC=aa:bb:cc:dd:ee:12
# DEVICE_NAME=RPi-Pill
# GRAVITY_OFFSET=0
# TEMP_OFFSET=0
